# Supabase pooled connection string (server-only)
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Admin boot hash (bcrypt). Runtime changes go to admin_credentials table.
# Generate from apps/misparat-lidor:
# node -e "require('bcryptjs').hash('your-password',10).then(console.log)"
ADMIN_PASSWORD_HASH=

# Session cookie signing (32+ random bytes)
SESSION_SECRET=change-me-to-a-long-random-string

# Cron shared secret for /api/cron/*
CRON_SECRET=change-me-cron-secret

# Israeli SMS vendor HTTP API
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=

# Resend (email confirmations + owner OTP)
RESEND_API_KEY=
RESEND_FROM=מספרת לידור <onboarding@resend.dev>
OWNER_EMAIL=

# Shop
SHOP_PHONE=+972535301669
SHOP_NAME=מספרת לידור
SHOP_ADDRESS=אבנר בן נר 1, אשדוד, ישראל
NEXT_PUBLIC_SHOP_PHONE=053-530-1669
NEXT_PUBLIC_SHOP_NAME=מספרת לידור
NEXT_PUBLIC_SHOP_ADDRESS=אבנר בן נר 1, אשדוד, ישראל

# Optional
SENTRY_DSN=
